# Copy to .env and fill in real values from your Supabase project (Settings > API,
# Settings > Database). Never commit .env — it's gitignored already.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

DATABASE_URL=

# Signs the session JWT (server/auth.js). Must stay fixed across every function
# instance/deploy, or everyone gets logged out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# Optional: your own STUN/TURN servers for Teamo Meet, as a JSON array, e.g.
#   [{"urls":"stun:stun.l.google.com:19302"}]
TEAMO_ICE_SERVERS=
